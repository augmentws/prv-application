APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pvr-core
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=priv-view-core
JWT_AUDIENCE=priv-view-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ROOT_TENANT_NAME=Priv-View Root
BOOTSTRAP_ROOT_TENANT_SLUG=root
BOOTSTRAP_SUPERUSER_EMAIL=admin@example.com
BOOTSTRAP_SUPERUSER_PASSWORD=replace-this-password
BOOTSTRAP_SUPERUSER_DISPLAY_NAME=Super Admin

# Used by the Next.js BFF in web/.env.local.
CORE_API_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:3000
ARTIFACT_MODE=embedded
ARTIFACT_BASE_URL=http://127.0.0.1:8001

# Embedding inference runs in-process by default and can instead use the
# separately deployed Embedding API. Pin MODEL_REVISION in production.
EMBEDDING_MODE=embedded
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=voyageai/voyage-4-nano
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true
EMBEDDING_TRUST_REMOTE_CODE=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_INPUTS=256
EMBEDDING_MAX_INPUT_CHARACTERS=200000
EMBEDDING_BASE_URL=http://127.0.0.1:8002
EMBEDDING_SERVICE_TOKEN=replace-with-at-least-32-random-characters
EMBEDDING_REQUEST_TIMEOUT_SECONDS=300
EMBEDDING_QUERY_MODE=embedded
EMBEDDING_QUERY_MODEL=voyageai/voyage-4-nano
EMBEDDING_QUERY_MODEL_REVISION=
EMBEDDING_QUERY_DEVICE=auto
EMBEDDING_QUERY_BASE_URL=http://127.0.0.1:8002
# Hosted Voyage mode. Standard real-time requests are the default because they
# can use standard/free credits. Enable Batch API only after billing is configured.
VOYAGE_API_KEY=
EMBEDDING_VOYAGE_BASE_URL=https://api.voyageai.com
EMBEDDING_VOYAGE_MAX_RETRIES=5
EMBEDDING_VOYAGE_RETRY_BASE_SECONDS=1
EMBEDDING_VOYAGE_REALTIME_CONCURRENCY=8
EMBEDDING_VOYAGE_TOKENS_PER_MINUTE=3000000
EMBEDDING_VOYAGE_REQUESTS_PER_MINUTE=2000
EMBEDDING_VOYAGE_BATCH_ENABLED=false
EMBEDDING_VOYAGE_BATCH_REQUEST_SIZE=100
EMBEDDING_VOYAGE_BATCH_POLL_SECONDS=15
EMBEDDING_VOYAGE_BATCH_CONCURRENCY=20
MATTER_EMBEDDING_BATCH_SIZE=250
MATTER_EMBEDDING_DOCUMENT_CONCURRENCY=8
MATTER_TOPIC_BATCH_SIZE=100
MATTER_BULK_TAG_BATCH_SIZE=250
EMBEDDING_TEXT_MAX_BYTES=10485760
CHUNK_TARGET_CHARACTERS=1800
CHUNK_MAX_CHARACTERS=2600
CHUNK_OVERLAP_CHARACTERS=200

# Durable matter document-import workflows. DBOS stores workflow state in the
# pvr-core database under its own schema.
DBOS_ENABLED=true
DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pvr-core
DBOS_SYSTEM_SCHEMA=dbos
DBOS_APPLICATION_NAME=priv-view-workflows
DBOS_APPLICATION_VERSION=0.1.0
MATTER_IMPORT_BATCH_SIZE=1000

# Agent definitions use the stable `configured-default` model key. This value
# resolves it to a Pydantic AI provider model ID; configure that provider's
# credentials separately in the process environment.
AGENT_DEFAULT_MODEL=google:gemini-3.7-flash
DEFINITION_ASSESSMENT_PROVIDER_BATCH_SIZE=50
DEFINITION_ASSESSMENT_PROVIDER_BATCH_POLL_SECONDS=15
GOOGLE_API_KEY=
AGENT_TURN_QUEUE_CONCURRENCY=4
AGENT_APPROVAL_TIMEOUT_SECONDS=604800
MODEL_TRACE_ENABLED=false
MODEL_TRACE_DIRECTORY=.model-traces
# Each provider/model receives an independent process-wide RPM/estimated-TPM
# bucket. These defaults stay below the Gemini developer free-tier limits;
# increase them to match the quota of the configured provider project.
MODEL_RATE_LIMIT_REQUESTS_PER_MINUTE=12
MODEL_RATE_LIMIT_INPUT_TOKENS_PER_MINUTE=200000
MODEL_RATE_LIMIT_MAX_RETRIES=5
MODEL_RATE_LIMIT_RETRY_BASE_SECONDS=1
MODEL_RATE_LIMIT_RETRY_MAX_SECONDS=120
MODEL_RATE_LIMIT_CHARACTERS_PER_TOKEN=3

# Search projection and OpenSearch. Local Compose disables the OpenSearch
# security plugin; production deployments must use TLS and credentials.
SEARCH_ENABLED=true
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_INDEX_PREFIX=pvr
SEARCH_REQUEST_TIMEOUT_SECONDS=30
SEARCH_BULK_BATCH_SIZE=500
SEARCH_PROJECTION_DOCUMENT_CONCURRENCY=8
# Maximum text read from a document artifact into one search projection.
SEARCH_BODY_TEXT_MAX_BYTES=10485760

# Artifact Service. The Artifact database is independent even in embedded mode.
ARTIFACT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pvr-artifact
ARTIFACT_STORAGE_ENDPOINT_URL=http://localhost:9000
ARTIFACT_STORAGE_ACCESS_KEY=minioadmin
ARTIFACT_STORAGE_SECRET_KEY=minioadmin
ARTIFACT_STORAGE_REGION=us-east-1
ARTIFACT_BUCKET_PREFIX=pv-artifacts
ARTIFACT_BUCKET_SUFFIX_LENGTH=10
ARTIFACT_DELEGATION_SECRET=replace-with-at-least-32-random-characters
ARTIFACT_DELEGATION_ISSUER=priv-view-core
ARTIFACT_DELEGATION_AUDIENCE=priv-view-artifact
