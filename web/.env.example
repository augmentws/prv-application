CORE_API_URL=http://127.0.0.1:8000
# Public browser origin used for same-origin validation and server redirects.
# Set this to the HTTPS hostname when running behind cloudflared or another proxy.
APP_ORIGIN=http://localhost:3000
# Optional additional browser origins accepted for login and mutation CSRF checks.
# Keep this explicit; wildcards are not supported.
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000
